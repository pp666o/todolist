# PostgreSQL / pgvector
POSTGRES_DB=geo_posts
POSTGRES_USER=geo_posts
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Remote MySQL post source
MYSQL_SOURCE_HOST=replace_with_mysql_host
MYSQL_SOURCE_PORT=3306
MYSQL_SOURCE_USER=replace_with_mysql_user
MYSQL_SOURCE_PASSWORD=replace_with_mysql_password
MYSQL_SOURCE_DATABASE=replace_with_mysql_database
MYSQL_SOURCE_TABLE=tiezi_geo_new
MYSQL_SOURCE_CHARSET=utf8mb4

# Redis realtime feature service
# In the cloud development container, connect through the SSH tunnel.
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT_SECONDS=3
